do homem mais forte do mundo..."], [3.98, 4.8, "que foi vencido"], [4.85, 6.07, "por uma lembrança."], [6.12, 8.209999999999999, "Em Shibuya, o Gojo tinha acabado de derrotar"], [8.26, 9.549999999999999, "centenas de maldições."], [9.6, 11.069999999999999, "Aí apareceu alguém"], [11.12, 12.725, "com o rosto do Suguru Geto."], [12.775, 13.819999999999999, "O melhor amigo dele..."], [13.87, 15.6, "que ele mesmo tinha matado."], [16.6, 17.43, "Por um instante,"], [17.48, 18.14, "a cabeça dele voltou"], [18.19, 19.259999999999998, "pros anos de escola"], [19.31, 20.24, "ao lado do amigo."], [20.29, 21.07, "E esse instante bastou."], [21.12, 23.28, "O Reino da Prisão se fechou."], [24.4, 25.79, "Uma caixa feita dos restos"], [25.84, 26.63, "de um monge, o Genshin."], [26.68, 27.33, "Lá dentro,"], [27.38, 28.4, "nem o Gojo consegue usar"], [28.45, 29.42, "energia amaldiçoada."], [31.12, 33.31, "Mas por que ele ficou tanto tempo lá?"], [33.36, 34.34, "Só duas ferramentas"], [34.39, 36.27, "abriam a porta de trás da prisão:"], [36.32, 37.720000000000006, "a Lança Invertida do Céu"], [37.77, 38.93, "e a Corda Negra."], [38.98, 40.38, "E as duas tinham sumido..."], [40.43, 41.88, "nas mãos do próprio Gojo."], [42.34, 43.470000000000006, "A saída foi o Anjo,"], [43.52, 44.870000000000005, "uma feiticeira com uma técnica"], [44.92, 46.88, "que apaga qualquer técnica."], [47.56, 48.870000000000005, "Quer aprender a fazer esses vídeos?"], [48.92, 50.43, "Link do meu Discord na bio."], [50.48, 51.06, "E o budismo,"], [51.11, 52.11, "a religião daquele monge,"], [52.16, 53.830000000000005, "ensina que o que prende a gente"], [53.88, 54.540000000000006, "não são correntes."], [54.59, 55.46, "É o apego."], [55.51, 57.190000000000005, "O Gojo podia vencer qualquer um..."], [57.24, 59.33, "menos o que sentia pelo amigo."], [60.52, 61.61, "Na história, foram semanas."], [61.66, 62.540000000000006, "Na vida real,"], [62.59, 64.16, "foram mais de três anos,"], [64.21, 65.546, "e cento e trinta e um capítulos."], [65.596, 68.09, "Se você pudesse rever alguém do seu passado"], [68.14, 68.88000000000001, "por um instante..."], [68.93, 69.45, "quem seria?"], [69.5, 70.29, "Comenta aí,"], [70.34, 72.09, "e me segue pra mais."]], "caps": [[6.02, "SHIBUYA"], [16.5, "UM INSTANTE"], [24.3, "O REINO DA PRISÃO"], [31.02, "AS CHAVES"], [42.24, "O ANJO"], [50.38, "APEGO"]], "fotos": []}