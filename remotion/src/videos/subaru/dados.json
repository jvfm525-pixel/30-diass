{"scenes": [["s0-capa", 0.0, 0.7], ["s1-abertura", 0.7, 8.56], ["s2-volta", 8.56, 19.44], ["s3-mao", 19.44, 30.52], ["s4-preco", 30.52, 38.4], ["s5-bruxa", 38.4, 48.5], ["s6-discord", 48.5, 51.5], ["s7-echidna", 51.5, 64.12], ["s8-heidegger", 64.12, 80.0], ["s9-fim", 80.0, 93.6]], "sc": {"s0-capa": [0.0, 0.7], "s1-abertura": [0.7, 8.56], "s2-volta": [8.56, 19.44], "s3-mao": [19.44, 30.52], "s4-preco": [30.52, 38.4], "s5-bruxa": [38.4, 48.5], "s6-discord": [48.5, 51.5], "s7-echidna": [51.5, 64.12], "s8-heidegger": [64.12, 80.0], "s9-fim": [80.0, 93.6]}, "par": {"s0-capa": [0.0, 0.7], "s1-abertura": [0.7, 8.56], "s2-volta": [8.56, 19.44], "s3-mao": [19.44, 30.52], "s4-preco": [30.52, 38.4], "s5-bruxa": [38.4, 48.5], "s6-discord": [48.5, 51.5], "s7-echidna": [51.5, 64.12], "s8-heidegger": [64.12, 80.0], "s9-fim": [80.0, 93.6]}, "k": {"morrer": 1.6, "acordar": 2.34, "antes": 4.23, "contar": 5.5, "ama": 8.36, "subaru": 8.82, "mundo": 10.63, "poder": 11.77, "morre": 12.95, "volta": 13.41, "lembra": 14.7, "outros": 16.1, "nunca": 18.22, "emilia3": 21.58, "parou": 22.42, "cinza": 23.87, "mao": 24.63, "peito": 26.0, "apertou": 26.72, "vez": 28.43, "volta3": 30.09, "piora": 30.93, "dele": 33.36, "ouvindo": 34.78, "morreu": 37.14, "emilia4": 37.71, "bruxa": 39.34, "satella": 40.69, "inveja": 43.58, "dividir": 44.63, "saber": 47.1, "carrega": 47.89, "aprender": 48.78, "link": 50.24, "discord": 50.73, "ouvir": 53.24, "echidna": 53.88, "castelo": 56.22, "alcance": 57.99, "falou": 59.69, "sabia": 63.6, "heidegger": 64.84, "morrer8": 66.75, "sua": 70.14, "letra": 72.94, "dezenas": 74.18, "dele8": 76.63, "lembra8": 77.75, "custou": 79.45, "castigo": 80.6, "salvar": 82.4, "sozinho": 84.59, "voltar9": 86.13, "voltaria": 89.26, "comenta": 90.0, "segue": 90.86}, "total": 93.6, "cut": false, "capa": 0.7, "provisorio": false, "legendas": [[0.78, 2.1900000000000004, "Imagina morrer..."], [2.24, 3.0, "e acordar de novo,"], [3.05, 4.180000000000001, "minutos antes."], [4.23, 6.12, "E não poder contar isso pra ninguém."], [6.17, 8.16, "Nem pra quem você mais ama."], [8.74, 10.959999999999999, "O Subaru Natsuki caiu em outro mundo"], [11.01, 12.299999999999999, "com um único poder:"], [12.35, 13.69, "quando morre, ele volta no tempo."], [13.74, 15.12, "Ele lembra de tudo."], [15.17, 16.05, "Os outros, não."], [16.1, 18.01, "Pra eles, aquilo nunca aconteceu."], [19.62, 22.009999999999998, "Na primeira vez que ele tentou contar pra Emilia,"], [22.06, 22.37, "o tempo parou."], [22.42, 23.65, "O mundo ficou cinza."], [23.77, 25.93, "E uma mão de sombra entrou no peito dele..."], [25.98, 26.669999999999998, "e apertou o coração."], [26.72, 28.63, "Toda vez que ele tenta,"], [28.68, 30.01, "a mão volta."], [30.7, 31.425, "E piora."], [31.475, 33.31, "Às vezes a mão não aperta o coração dele."], [33.36, 34.480000000000004, "Aperta o de quem está ouvindo."], [34.53, 35.52, "Numa das voltas,"], [35.57, 37.66, "quem morreu foi a Emilia."], [38.58, 40.580000000000005, "Essa mão é da Bruxa da Inveja,"], [40.63, 41.45, "a Satella."], [41.5, 42.98, "A teoria mais aceita é simples:"], [43.14, 43.53, "inveja."], [43.58, 45.59, "Ela não quer dividir o Subaru com ninguém."], [45.64, 47.98, "Só ela pode saber o que ele carrega."], [48.68, 50.190000000000005, "Quer aprender a fazer esses vídeos?"], [50.24, 51.63, "Link do meu Discord na bio."], [51.68, 53.75, "Só uma pessoa conseguiu ouvir:"], [53.8, 55.150000000000006, "a Echidna, a Bruxa da Ganância."], [55.2, 56.95, "No castelo dos sonhos dela,"], [57.0, 58.36, "longe do alcance da Satella,"], [58.41, 60.400000000000006, "o Subaru falou pela primeira vez."], [60.45, 61.940000000000005, "E, pela primeira vez,"], [61.99, 63.34, "alguém sabia."], [64.3, 65.89, "O filósofo Heidegger escreveu"], [65.94, 68.45, "que ninguém pode morrer no lugar de outra pessoa."], [68.5, 71.11, "A morte é a coisa mais sua que existe."], [71.16, 73.39, "O Subaru vive isso ao pé da letra:"], [73.44, 74.99000000000001, "ele já morreu dezenas de vezes,"], [75.04, 76.58, "e cada morte é só dele."], [76.63, 77.31, "Ninguém lembra."], [77.36, 79.24, "Ninguém sabe o quanto custou."], [80.18, 82.25, "Talvez o castigo não seja morrer."], [82.3, 83.85000000000001, "É salvar todo mundo..."], [83.9, 85.25500000000001, "e continuar sozinho."], [85.305, 86.89, "Se você pudesse voltar no tempo,"], [86.94, 88.22, "mas nunca contar pra ninguém..."], [88.27, 89.21000000000001, "você voltaria?"], [89.26, 89.95, "Comenta aí,"], [90.0, 91.48, "e me segue pra mais."]], "caps": [[8.64, "VOLTAR DA MORTE"], [19.52, "A MÃO"], [30.6, "O PREÇO"], [38.48, "A BRUXA"], [51.58, "A EXCEÇÃO"], [64.2, "SÓ DELE"]], "fotos": []}